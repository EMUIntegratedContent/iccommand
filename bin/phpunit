#!/usr/bin/env php
<?php

// Runs the PHPUnit version from composer.json (vendor/bin/phpunit) with phpunit.xml.dist.
if (!is_file(dirname(__DIR__).'/vendor/phpunit/phpunit/phpunit')) {
    echo "PHPUnit is not installed. Run \"composer install\" (with dev dependencies) first.\n";
    exit(1);
}

require dirname(__DIR__).'/vendor/phpunit/phpunit/phpunit';

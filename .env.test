# Committed defaults for the test environment (APP_ENV=test).
#
# Load order (later files win, real environment variables beat all files):
#   .env  ->  .env.local  ->  .env.test  ->  .env.test.local
# So anything set here overrides your .env.local while tests run. Put machine-specific
# overrides in .env.test.local (git-ignored).
#
# Database settings are deliberately NOT set here: locally, tests use the database in your
# .env / .env.local (each test runs inside a transaction that is rolled back, see
# dama/doctrine-test-bundle). CI sets DATABASE_* as job environment variables and points them
# at a throwaway MariaDB with an empty schema.

KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'

# Mail goes to the null transport in the test env (config/packages/mailer.yaml); this value
# only has to exist.
MAILER_URL=null://null
LOCK_DSN=flock
GOOGLE_MAPS_API_KEY=test-key-not-used

# Known shared secret so tests can call the emich.edu server-to-server routes.
EXTERNAL_API_TOKEN=test-external-api-token
EXTERNAL_API_TOKEN_MODE=enforce

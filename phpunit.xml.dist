<?xml version="1.0" encoding="UTF-8"?>

<!-- https://docs.phpunit.de/en/13.4/configuration.html (bin/phpunit runs vendor/bin/phpunit) -->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         backupGlobals="false"
         colors="true"
         bootstrap="tests/bootstrap.php"
         cacheDirectory="var/cache/phpunit"
         defaultTestSuite="Project Test Suite"
         displayDetailsOnTestsThatTriggerDeprecations="true"
         displayDetailsOnPhpunitDeprecations="true"
         displayDetailsOnTestsThatTriggerWarnings="true"
         displayDetailsOnTestsThatTriggerNotices="true"
         displayDetailsOnTestsThatTriggerErrors="true"
         displayDetailsOnSkippedTests="true"
>
    <php>
        <ini name="error_reporting" value="-1" />
        <!-- Production runs in America/Detroit; date-sensitive code (scholarship deadlines, crime log) must see the same. -->
        <ini name="date.timezone" value="America/Detroit" />
        <!-- force: an APP_ENV already in the shell (e.g. from sourcing .env) must not win -->
        <env name="APP_ENV" value="test" force="true" />
        <env name="APP_DEBUG" value="1" force="true" />
        <env name="SHELL_VERBOSITY" value="-1" />
        <!-- Other test settings are in .env.test. -->
    </php>

    <testsuites>
        <testsuite name="Project Test Suite">
            <directory>tests/</directory>
        </testsuite>
        <testsuite name="advisors">
            <directory>tests/Api/Advisors</directory>
            <file>tests/Api/Ic/IcAdvisorFeedsTest.php</file>
            <directory>tests/Controller/Advisors</directory>
        </testsuite>
        <testsuite name="security">
            <directory>tests/Security</directory>
        </testsuite>
    </testsuites>

    <!-- Deprecations are reported only when our code (src/) triggers them, directly or through a
         Symfony/Doctrine call it makes. Vendor-internal deprecations are not ours to fix. -->
    <source ignoreSuppressionOfDeprecations="true" ignoreIndirectDeprecations="true">
        <deprecationTrigger>
            <function>trigger_deprecation</function>
            <method>Doctrine\Deprecations\Deprecation::trigger</method>
            <method>Doctrine\Deprecations\Deprecation::triggerIfCalledFromOutside</method>
        </deprecationTrigger>
        <include>
            <directory suffix=".php">src/</directory>
        </include>
    </source>

    <extensions>
        <!-- Symfony's ClockMock/DnsMock attributes and kernel-state reset between tests -->
        <bootstrap class="Symfony\Bridge\PhpUnit\SymfonyExtension" />
        <!-- Each test runs inside a transaction (all three connections) that is rolled back afterwards -->
        <bootstrap class="DAMA\DoctrineTestBundle\PHPUnit\PHPUnitExtension" />
    </extensions>
</phpunit>
